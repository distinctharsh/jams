    app_id INT NOT NULL,
    vendor_id INT NULL,
    vendor_name VARCHAR(255) NULL,
    technical_specifications TEXT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NULL
);



