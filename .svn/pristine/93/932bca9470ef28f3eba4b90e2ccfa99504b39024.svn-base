function generateApplicationPdfHTML(data) {
    const app = data.application || {};
    const examDetails = data.exam_details || [];
    const vendors = data.vendors || [];
    
    // Format date
    const createdDate = app.created_at ? new Date(app.created_at) : new Date();
    const formattedDate = createdDate.toLocaleDateString('en-GB', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    });

    // Generate exam rows
    let examRows = '';
    if (examDetails.length > 0) {
        examDetails.forEach((exam, index) => {
            examRows += `
                <tr>
                    <td class="center" style="width:7%;">${index + 1}</td>
                    <td class="left" style="width:22%;font-weight:600;">${escapeHtml(exam.exam_name || '—')}</td>
                    <td class="center" style="width:15%;">${escapeHtml(exam.exam_date || '—')}</td>
                    <td class="left" style="width:31%;">${escapeHtml(exam.centre_address || '—')}</td>
                    <td class="center" style="width:13%;">${escapeHtml(exam.centre_name || '—')}</td>
                    <td class="center" style="width:12%;">${escapeHtml(exam.state_name || '—')}</td>
                </tr>
            `;
        });
    } else {
        examRows = `
            <tr>
                <td colspan="6" class="center" style="color:#94a3b8;padding:15px;">No examination details found</td>
            </tr>
        `;
    }

    // Generate vendor rows
    let vendorRows = '';
    if (vendors.length > 0) {
        vendors.forEach((vendor, index) => {
            vendorRows += `
                <tr>
                    <td class="center" style="width:8%;">${index + 1}</td>
                    <td style="width:42%;font-weight:600;">${escapeHtml(vendor.vendor_name || '—')}</td>
                    <td style="width:50%;">${escapeHtml(vendor.jammer_model_name || '—')}</td>
                </tr>
            `;
        });
    } else {
        vendorRows = `
            <tr>
                <td colspan="3" class="center" style="color:#94a3b8;padding:15px;">No vendor details found</td>
            </tr>
        `;
    }

    return `
