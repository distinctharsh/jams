        margin-bottom: 8px;
    }
    .place-line {
        margin-top: 35px;
        width: 160px;
        border-top: 1px solid #cbd5e1;
    }
    .signature { text-align: right; }
    .signature-space { height: 45px; }
    .signature-line {
        display: inline-block;
        min-width: 200px;
        border-top: 1.5px solid #94a3b8;
        padding-top: 8px;
    }
    .signatory {
        font-size: 11px;
        font-weight: 700;
        color: #1e293b;
    }
    .designation {
        font-size: 9.5px;
        color: #64748b;
        margin-top: 4px;
    }
    .signature-date {
        font-size: 10px;
        color: #475569;
        margin-top: 8px;
    }
    
    .page-footer {
        text-align: center;
        font-size: 9px;
        color: #94a3b8;
        margin-top: 20px;
        padding-top: 10px;
        border-top: 1px solid #e2e8f0;
    }
    
    /* Centre not available notice */
    .centre-notice {
        background: #fef3c7;
        border: 1px solid #f59e0b;
        border-left: 4px solid #f59e0b;
        padding: 12px 16px;
        margin: 10px 0;
