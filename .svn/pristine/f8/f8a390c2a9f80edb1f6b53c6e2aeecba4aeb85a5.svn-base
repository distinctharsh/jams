        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    .centre-notice strong {
        color: #92400e;
        font-weight: 700;
    }
    .centre-notice .acknowledge {
        display: inline-block;
        margin-top: 6px;
        font-size: 10.5px;
        color: #78350f;
        font-weight: 600;
