<style>
    .custom-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
}

.custom-modal.show {
    display: flex;
}

.custom-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
}

.custom-modal-box {
    position: relative;
    width: 100%;
    max-width: 500px;
    margin: 20px;
    background: #ffffff;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.20);
    overflow: hidden;
    z-index: 2;

    animation: customModalShow 0.2s ease-out;
}

@keyframes customModalShow {
    from {
        opacity: 0;
        transform: translateY(-15px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}


/* =========================
   HEADER
   ========================= */

.custom-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 22px 10px;
}

.custom-modal-header h5 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
}

.custom-modal-header h5 i {
    margin-right: 8px;
    color: #2563eb;
}

.custom-modal-header h5 .reject-icon {
    color: #dc2626;
}

.custom-modal-close {
    border: 0;
    background: transparent;
    color: #64748b;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
}

.custom-modal-close:hover {
    background: #f1f5f9;
    color: #0f172a;
}


/* =========================
   BODY
   ========================= */

.custom-modal-body {
    padding: 12px 22px 18px;
}

.custom-form-group {
    margin-bottom: 16px;
}

.custom-form-group label {
    display: block;
    margin-bottom: 7px;
    font-size: 14px;
    font-weight: 600;
    color: #334155;
}

.custom-form-group label span {
    color: #dc2626;
}

.custom-form-group select,
.custom-form-group input,
.custom-form-group textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    padding: 10px 12px;
    font-size: 14px;
    color: #334155;
    background: #ffffff;
    outline: none;
    transition: all 0.2s ease;
}

.custom-form-group select {
    height: 42px;
}

.custom-form-group input {
    height: 42px;
}

.custom-form-group textarea {
    resize: vertical;
    min-height: 85px;
}

.custom-form-group select:focus,
.custom-form-group input:focus,
.custom-form-group textarea:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
}


/* =========================
   CHECKBOX
   ========================= */

.custom-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 5px;
}

.custom-checkbox input {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    cursor: pointer;
}

.custom-checkbox label {
    font-size: 13px;
    line-height: 1.5;
    color: #64748b;
    cursor: pointer;
}


/* =========================
   FOOTER
   ========================= */

.custom-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 0 22px 20px;
}

.custom-btn {
    border: 0;
    border-radius: 999px;
    padding: 9px 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.custom-btn-secondary {
    background: #64748b;
    color: #ffffff;
}

.custom-btn-secondary:hover {
    background: #475569;
}

.custom-btn-primary {
    background: #2563eb;
    color: #ffffff;
}

.custom-btn-primary:hover {
