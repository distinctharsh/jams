<style>
/* =========================================================
   JAMMERS APPROVAL MANAGEMENT SYSTEM
   APPLICANT + ORGANIZATION + AUTHORIZATION LETTER
   ========================================================= */

:root {
    --gov-blue: #174a78;
    --gov-blue-dark: #123b60;
    --gov-blue-light: #eef5fb;
    --gov-white: #fff;
    --gov-orange: #e58500;
    --gov-green: #138808;
    --gov-red: #c62828;
    --text: #1e293b;
    --text-soft: #475569;
    --muted: #64748b;
    --border: #dbe4ec;
    --border-light: #e8eef4;
    --page-bg: #f4f7fa;
    --white: #ffffff;
    --shadow: 0 16px 40px rgba(15, 23, 42, 0.09);
}

/* =========================================================
   RESET
   ========================================================= */

* {
    box-sizing: border-box;
}

/* =========================================================
   BODY
   ========================================================= */

body {
    margin: 0;
    color: var(--text);
    background: var(--page-bg);
    font-family: "Segoe UI", Roboto, Arial, sans-serif;
}

/* =========================================================
   HEADER
   ========================================================= */

header,
.navbar,
.site-header,
.main-header,
.fixed-top {
    z-index: 9999 !important;
}

/* =========================================================
   MAIN PAGE
   ========================================================= */

main.signup-page-main {
    position: relative !important;
    display: block !important;
    width: 100%;
    min-height: 100vh;
    margin: 0 !important;
    padding-top: 185px !important;
    padding-bottom: 45px !important;
    background:
        radial-gradient(circle at 5% 10%, rgba(23, 74, 120, 0.055), transparent 28%),
        radial-gradient(circle at 95% 90%, rgba(19, 136, 8, 0.035), transparent 25%),
        var(--page-bg);
}

/* =========================================================
   PAGE WRAPPER
   ========================================================= */

.authorization-page-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1266px;
    margin: 0 auto;
}

/* =========================================================
   MAIN TWO-COLUMN LAYOUT
   ========================================================= */

.authorization-layout {
    display: grid;
    grid-template-columns: minmax(0, 61%) minmax(0, 39%);
    align-items: start;
    gap: 18px;
    width: 100%;
}

.authorization-layout.single-column {
    grid-template-columns: 100%;
}

/* =========================================================
   LEFT CONTAINER
   ========================================================= */

.gov-left-container {
    position: relative;
    min-width: 0;
    padding: 32px 28px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
    overflow: hidden;
}

/* =========================================================
   LEFT DECORATION
   ========================================================= */

.gov-left-container::before {
    content: "";
    position: absolute;
    width: 210px;
    height: 210px;
    top: -125px;
    right: -120px;
    border: 25px solid rgba(23, 74, 120, 0.035);
    border-radius: 50%;
    pointer-events: none;
}

.gov-left-container::after {
    content: "";
    position: absolute;
    width: 170px;
    height: 170px;
    left: -120px;
    bottom: -105px;
    border: 22px solid rgba(19, 136, 8, 0.035);
    border-radius: 50%;
    pointer-events: none;
}

/* =========================================================
   GOVERNMENT TITLE
   ========================================================= */

.left-title {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 16px;
    padding: 10px 20px;
    color: var(--gov-white);
    background: var(--gov-blue);
}

.title-logo {
    width: 58px !important;
    height: 58px !important;
    flex: 0 0 58px !important;
    display: block;
    object-fit: contain;
    padding: 6px;
    background: #fff;
    border: 1px solid #dbe4ec;
    border-radius: 6px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

.title-content {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.title-text {
    display: block;
    color: var(--gov-white);
    font-size: 18px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.5px;
}

.left-subtitle {
    margin-top: 5px;
