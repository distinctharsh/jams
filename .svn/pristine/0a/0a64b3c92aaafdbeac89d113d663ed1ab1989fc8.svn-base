    font-size: 12px;
    line-height: 1.5;
}

/* =========================================================
   HEADER DIVIDER
   ========================================================= */

.header-divider {
    width: 100%;
    max-width: 1031px;
    height: 3px;
    margin-top: 8px;
    margin-bottom: 22px;
