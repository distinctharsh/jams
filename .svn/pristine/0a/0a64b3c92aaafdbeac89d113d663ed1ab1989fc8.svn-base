<script>
/* =========================================================
   CSRF
========================================================= */

function getCSRFHash() {
    return $('#csrf_token').val() || '';
}

function updateCSRF(hash) {
    if (hash) {
        $('#csrf_token').val(hash);
    }
}

/* =========================================================
   REFRESH CAPTCHA
========================================================= */

function refreshAuthorizationCaptcha(autoFocus = false) {
    const button = $('#signupRefreshCaptcha');

    if (button.length) {
        button.prop('disabled', true);
        button.find('i').addClass('fa-spin');
    }

    $.ajax({
        url: "<?= base_url('refresh-captcha') ?>",
        type: "POST",
        dataType: "json",
        data: {
            csrf_token: getCSRFHash()
        },
        headers: {
            "X-Requested-With": "XMLHttpRequest",
            "X-CSRF-TOKEN": getCSRFHash()
        },
        success: function(response) {
            console.log('CAPTCHA REFRESH:', response);

            if (response.csrfHash) {
                updateCSRF(response.csrfHash);
            }

            if (response.success) {
                $('#signupCaptchaText').text(response.captcha);
                $('#captcha').val('');

                if (autoFocus) {
                    $('#captcha').focus();
                }
            } else {
                console.log('CAPTCHA REFRESH FAILED:', response.message);
            }
        },
        error: function(xhr) {
            console.log('CAPTCHA REFRESH ERROR:', xhr.responseText);
        },
        complete: function() {
            if (button.length) {
                button.prop('disabled', false);
                button.find('i').removeClass('fa-spin');
            }
        }
    });
}

/* =========================================================
   REFRESH BUTTON
========================================================= */

$(document).on('click', '#signupRefreshCaptcha', function(e) {
    e.preventDefault();
    refreshAuthorizationCaptcha(true);
});

/* =========================================================
   DOCUMENT READY
========================================================= */

$(document).ready(function() {

    /*
     * -----------------------------------------------------
     * REFRESH CAPTCHA ON PAGE LOAD
     * -----------------------------------------------------
     */
    refreshAuthorizationCaptcha(false);

    /*
     * =====================================================
     * AUTHORIZATION FORM
     * =====================================================
     */
    $('#authorizationForm').on('submit', function(e) {
        e.preventDefault();

        const form = this;

        /*
         * -------------------------------------------------
         * FILE
         * -------------------------------------------------
         */
        const fileInput = $('#authorization_letter')[0];
        const file = fileInput && fileInput.files ? fileInput.files[0] : null;

        if (!file) {
            showToast('warning', 'Please select Authorization Letter.');
            return;
        }

        /*
         * -------------------------------------------------
         * FILE SIZE
         * -------------------------------------------------
         */
        if (file.size > 5 * 1024 * 1024) {
            showToast('danger', 'Maximum file size is 5 MB.');
            return;
        }

        /*
         * -------------------------------------------------
         * CAPTCHA
         * -------------------------------------------------
         */
        const captcha = $.trim($('#captcha').val());

        if (!captcha) {
            showToast('warning', 'Please enter CAPTCHA code.');
            $('#captcha').focus();
            return;
        }

        /*
         * -------------------------------------------------
         * TOKEN
         * -------------------------------------------------
         */
        const authorizationToken = $.trim($('#authorization_token').val());

        if (!authorizationToken) {
            showToast('danger', 'Authorization token is missing. Please reload the page.');
            return;
        }

        /*
         * -------------------------------------------------
         * FORM DATA
         * -------------------------------------------------
         */
        const formData = new FormData(form);
        formData.set('token', authorizationToken);
        formData.set('captcha', captcha);
        formData.set('<?= csrf_token() ?>', getCSRFHash());

        /*
         * -------------------------------------------------
         * DEBUG
         * -------------------------------------------------
         */
        console.log('POST TOKEN:', formData.get('token'));
        console.log('POST CAPTCHA:', formData.get('captcha'));
        console.log('POST CSRF:', formData.get('<?= csrf_token() ?>'));

        /*
         * -------------------------------------------------
         * DISABLE BUTTON
         * -------------------------------------------------
         */
        $('#uploadBtn')
            .prop('disabled', true)
            .html('<i class="fas fa-spinner fa-spin me-2"></i>Uploading...');

        /*
         * =================================================
         * AJAX
         * =================================================
         */
        $.ajax({
            url: "<?= base_url('auth/upload-authorization') ?>",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            dataType: "json",
            headers: {
                "X-Requested-With": "XMLHttpRequest",
                "X-CSRF-TOKEN": getCSRFHash()
            },

            /*
             * =============================================
             * SUCCESS
             * =============================================
             */
            success: function(response) {
                console.log('UPLOAD RESPONSE:', response);

                /*
                 * UPDATE CSRF
                 */
                if (response.csrfHash) {
                    updateCSRF(response.csrfHash);
                }

                /*
                 * SUCCESS
                 */
                if (response.success) {
                    showToast('success', response.message || 'Authorization Letter submitted successfully.');

                    setTimeout(function() {
                        if (response.redirect) {
                            window.location.href = response.redirect;
                        } else {
                            window.location.reload();
                        }
                    }, 1500);

                    return;
                }

                /*
                 * FAILED
                 */
                showToast('error', response.message || 'Something went wrong.');
                $('#captcha').val('');
                refreshAuthorizationCaptcha(true);

                /*
                 * ENABLE
                 */
                $('#uploadBtn')
                    .prop('disabled', false)
                    .html('<i class="fas fa-paper-plane me-2"></i>Submit Authorization Letter');
            },

            /*
             * =============================================
             * AJAX ERROR
             * =============================================
             */
            error: function(xhr) {
                console.log('UPLOAD ERROR:', xhr.status);
                console.log(xhr.responseText);

                let message = 'Server error. Please try again.';

                try {
                    const response = JSON.parse(xhr.responseText);

                    if (response.csrfHash) {
                        updateCSRF(response.csrfHash);
                    }

                    if (response.message) {
                        message = response.message;
                    }
                } catch (error) {
                    console.log('Invalid JSON response');
                }

                showToast('error', message);
                $('#captcha').val('');
                refreshAuthorizationCaptcha(false);

                /*
                 * ENABLE
                 */
                $('#uploadBtn')
                    .prop('disabled', false)
                    .html('<i class="fas fa-paper-plane me-2"></i>Submit Authorization Letter');
            }
        });

    });

});
</script>