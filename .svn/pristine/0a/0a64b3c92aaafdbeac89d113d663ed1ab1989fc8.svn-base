}

.document-icon {
    width: 46px;
    height: 46px;
    flex: 0 0 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #dbe7f1;
    border-radius: 10px;
    background: var(--gov-blue-light);
    color: var(--gov-blue);
    font-size: 17px;
}

/* =========================================================
   ORGANIZATION STRIP
   ========================================================= */

.organization-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 11px;
    margin-bottom: 21px;
}

.org-mini-box {
    min-width: 0;
    padding: 11px 13px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 9px;
}

.org-mini-label {
    display: block;
    margin-bottom: 4px;
    color: #94a3b8;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.55px;
}

.org-mini-value {
    color: var(--text);
    font-size: 12px;
    line-height: 1.4;
    font-weight: 700;
    word-break: break-word;
    overflow-wrap: anywhere;
}

/* =========================================================
   FORM SECTION TITLE
   ========================================================= */

.form-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 11px;
    color: #334155;
    font-size: 13px;
    font-weight: 700;
}

.form-section-title i {
    color: var(--gov-blue);
    font-size: 13px;
}

/* =========================================================
   FORM LABEL
   ========================================================= */

.form-label {
    display: block;
    margin-bottom: 5px;
    color: #334155;
    font-size: 11px;
    font-weight: 650;
}

/* =========================================================
   FORM CONTROL
   ========================================================= */

.form-control {
    width: 100%;
    min-height: 42px;
    padding: 9px 12px;
    border: 1px solid #cfd9e3;
    border-radius: 7px;
    color: #1e293b;
    background: #fff;
    font-size: 12px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.form-control:hover {
    border-color: #b9c8d6;
}

.form-control:focus {
    border-color: var(--gov-blue);
    outline: none;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(23, 74, 120, 0.09);
}

/* =========================================================
   FILE UPLOAD
   ========================================================= */

.file-upload-wrapper .form-control::file-selector-button {
    height: 40px;
    margin: -9px 11px -9px -12px;
    padding: 0 13px;
    border: 0;
    background: var(--gov-blue);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
}

.file-help {
    display: block;
    margin-top: 5px;
    color: #94a3b8;
    font-size: 9.5px;
    line-height: 1.45;
}

/* =========================================================
   CAPTCHA
   ========================================================= */

.captcha-wrapper {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 155px 42px;
    gap: 8px;
    width: 100%;
}

.captcha-display {
    position: relative;
    height: 42px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #cbd7e2;
    border-radius: 7px;
    background:
        radial-gradient(#aebdca 0.7px, transparent 0.7px),
        linear-gradient(135deg, #f5f8fb, #fff);
    background-size: 7px 7px, 100% 100%;
}

.captcha-display::before,
.captcha-display::after {
    content: "";
    position: absolute;
    left: -10%;
    width: 120%;
    height: 1px;
    background: #64748b;
    opacity: 0.25;
}

.captcha-display::before {
    transform: rotate(7deg);
}

.captcha-display::after {
    transform: rotate(-8deg);
}

.captcha-text {
    position: relative;
    z-index: 2;
    color: var(--gov-blue);
    font-family: "Courier New", monospace;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 3px;
    text-decoration: line-through;
    user-select: none;
}

.captcha-refresh {
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid #cbd7e2;
    border-radius: 7px;
    background: #fff;
    color: var(--gov-blue);
    cursor: pointer;
}

.captcha-refresh:hover {
    color: #fff;
    background: var(--gov-blue);
    border-color: var(--gov-blue);
}

#captcha {
    width: 100%;
    height: 42px;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.7px;
    text-transform: uppercase;
}

#captcha::placeholder {
    color: #9aa8b6;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
}

/* =========================================================
   SECURITY NOTICE
   ========================================================= */

.security-notice {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 13px;
    padding: 10px 12px;
    background: #f4f8fc;
    border: 1px solid #d9e5ef;
    border-radius: 7px;
}

.security-notice i {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--gov-blue);
    font-size: 13px;
}

.security-notice span {
    color: #64748b;
    font-size: 9.5px;
    line-height: 1.5;
}

/* =========================================================
   SUBMIT BUTTON
   ========================================================= */

.gov-submit {
    width: 100%;
    min-height: 44px;
    margin-top: 14px;
    padding: 9px 16px;
    border: 0;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--gov-blue), #246496);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 5px 14px rgba(23, 74, 120, 0.18);
}

.gov-submit:hover {
    background: linear-gradient(135deg, var(--gov-blue-dark), var(--gov-blue));
    transform: translateY(-1px);
}

.gov-submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
}

/* =========================================================
   SUBMITTED DOCUMENT CARD
   ========================================================= */

.submitted-document-card {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 105px;
    margin-top: 18px;
    padding: 20px 24px;
    background: linear-gradient(135deg, #fff 0%, #f8fbfd 100%);
    border: 1px solid #e2e8f0;
    border-radius: 15px;
    box-shadow: 0 5px 18px rgba(15, 42, 70, 0.06);
}

.submitted-document-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: #1e4d7b;
}

.document-card-icon {
    width: 64px;
    min-width: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.document-icon-bg {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #eef5fb;
    color: #1e4d7b;
    font-size: 22px;
}

.document-card-content {
    flex: 1;
    min-width: 0;
    padding: 0 20px;
}

.document-card-label {
    margin-bottom: 3px;
    color: #8a97a6;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.document-card-title {
    color: #183b5d;
    font-size: 17px;
    font-weight: 700;
}

.document-card-description {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 5px;
    color: #718096;
    font-size: 11px;
}

.document-card-description i {
    color: #198754;
}

.document-card-status {
    display: flex;
    align-items: flex-end;
    flex-direction: column;
    gap: 7px;
    min-width: 115px;
}

.document-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 20px;
    background: #e8f7ef;
    color: #157347;
    font-size: 10px;
    font-weight: 700;
}

.document-secure {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #9aa6b2;
    font-size: 9px;
}

/* =========================================================
   SECURITY BOX
   ========================================================= */

.verification-box {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: 18px;
    padding: 11px 12px;
    background: #f4faf5;
    border: 1px solid #d7eadb;
    border-radius: 9px;
}

.verification-icon {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #e8f7ef;
    color: #138808;
}

.verification-text strong {
    display: block;
    color: #1e293b;
    font-size: 12px;
}

.verification-text span {
    display: block;
    margin-top: 2px;
    color: #64748b;
    font-size: 10px;
}

/* =========================================================
   RIGHT CONTAINER
   ========================================================= */

.gov-right-container {
    position: relative;
    min-width: 0;
    padding: 17px;
    background: #f8fafc;
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
}

/* =========================================================
   SUBMISSION PROGRESS
   ========================================================= */

.submission-progress-container {
    width: 94%;
    margin: 0 auto;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 5px 18px rgba(15, 42, 70, 0.06);
    overflow: hidden;
}

.submission-progress-card {
    width: 100%;
    padding: 22px 24px 24px;
    background: #fff;
}

/* =========================================================
   PROGRESS HEADER
   ========================================================= */

.submission-progress-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 14px 18px;
    margin: 0 -24px 20px;
    background: #174a78;
    color: #fff;
    border-radius: 0;
    border-bottom: 3px solid #123b60;
}

.submission-progress-header h3 {
    margin: 0;
    color: #fff;
    font-size: 17px;
    font-weight: 600;
}

.submission-progress-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: #1e4d7b;
    font-size: 16px;
    font-weight: 800;
}

.submission-progress-percent {
    color: #fff;
    font-size: 13px;
    font-weight: 800;
}

/* =========================================================
   COMPLETENESS
   ========================================================= */

.progress-completeness {
    margin-bottom: 24px;
}

.progress-completeness-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 7px;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
}

.progress-completeness-percent {
    color: #e58500;
    font-weight: 800;
}

.submission-progress-track {
    width: 100%;
    height: 8px;
    overflow: hidden;
    background: #e2e8f0;
    border-radius: 20px;
}

.submission-progress-fill {
    height: 100%;
    border-radius: 20px;
    background: #e58500;
    transition: width 0.5s ease;
}

/* =========================================================
   PROGRESS STEPS
   ========================================================= */

.submission-progress-steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 21px;
}

.submission-progress-steps::before {
    content: "";
    position: absolute;
    left: 15px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    background: #e2e8f0;
}

.progress-step {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 12px;
}

.progress-step-number {
    width: 32px;
    height: 32px;
    min-width: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #f1f5f9;
    border: 2px solid #cbd5e1;
    color: #64748b;
    font-size: 11px;
    font-weight: 800;
}

.progress-step.active .progress-step-number {
    background: #1e4d7b;
    border-color: #1e4d7b;
    color: #fff;
    box-shadow: 0 0 0 4px #eef5fb;
}

.progress-step.completed .progress-step-number {
    background: #198754;
    border-color: #198754;
    color: #fff;
    box-shadow: 0 0 0 4px #e8f7ef;
}

.progress-step.rejected .progress-step-number {
    background: #dc3545;
    border-color: #dc3545;
    color: #fff;
    box-shadow: 0 0 0 4px #fdebed;
}

/* =========================================================
   STEP CONTENT
   ========================================================= */

.progress-step-content {
    min-width: 0;
    padding-top: 1px;
}

.progress-step-title {
    margin: 0;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
}

.progress-step.active .progress-step-title {
    color: #1e4d7b;
}

.progress-step.completed .progress-step-title {
    color: #157347;
}

.progress-step.rejected .progress-step-title {
    color: #b02a37;
}

.progress-step-description {
    margin: 3px 0 0;
    color: #94a3b8;
    font-size: 10.5px;
    line-height: 1.5;
}

/* =========================================================
   STATUS MESSAGE
   ========================================================= */

.progress-status-message {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 20px;
    padding: 10px 12px;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 10px;
    line-height: 1.5;
}

.progress-status-message.approved {
    background: #f0faf4;
    border-color: #ccebd9;
    color: #157347;
}

.progress-status-message.rejected {
    background: #fff4f5;
    border-color: #f3cbd0;
    color: #b02a37;
}

/* =========================================================
   MESSAGE
   ========================================================= */

#message {
    margin-top: 12px;
    font-size: 11px;
}

/* =========================================================
   TOAST
   ========================================================= */

#toastContainer {
    position: fixed !important;
    top: 20px !important;
    right: 20px !important;
    width: 350px;
    max-width: calc(100% - 30px);
    z-index: 99999 !important;
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {
    main.signup-page-main {
        padding-top: 145px !important;
    }

    .authorization-layout {
        grid-template-columns: 42% 58%;
        gap: 14px;
    }

    .gov-left-container {
        padding: 27px 22px;
    }

    .gov-right-container {
        padding: 14px;
    }

    .information-row {
        gap: 10px;
