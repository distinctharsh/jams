}

.form-header-title {
    color: #fff !important;
    font-weight: 700;
}

.form-header-subtitle {
    color: #fff !important;
    opacity: 0.9;
    font-size: 14px;
}

.header-divider {
    height: 2px;
    background: rgba(255,255,255,0.7);
    margin-top: 12px;
}

/* =========================================================
   REGISTRATION SUCCESS MODAL
========================================================= */

.registration-success-modal {
    border: none;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
}


/* =========================================================
   SUCCESS HEADER
========================================================= */

.success-header {
    background: linear-gradient(
        135deg,
        #174a78,
        #1e5d91
    );

    color: #ffffff;
    padding: 20px 24px;
    border-bottom: 0;
}

.success-header-content {
    display: flex;
    align-items: center;
    gap: 15px;
}

.success-icon {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #ffffff;
    color: #198754;

    border-radius: 50%;
    font-size: 22px;

    flex-shrink: 0;
}

.success-header .modal-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0;
}

.success-subtitle {
    margin: 4px 0 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.85);
}


/* =========================================================
   BODY
========================================================= */

.registration-success-modal .modal-body {
    padding: 25px;
    background: #ffffff;
}


/* =========================================================
   SUCCESS MESSAGE
========================================================= */

.success-message-box {
    display: flex;
    gap: 15px;

    padding: 17px 18px;

    background: #f0fdf4;
    border: 1px solid #bbf7d0;

    border-radius: 12px;
    margin-bottom: 22px;
}

.success-message-icon {
    color: #198754;
    font-size: 28px;
    padding-top: 2px;
}

.success-message-box h6 {
    margin: 0 0 6px;
    color: #166534;
    font-size: 16px;
    font-weight: 700;
}

.success-message-box p {
    margin: 0 0 5px;
    color: #475467;
    font-size: 13px;
    line-height: 1.6;
}


/* =========================================================
   REGISTRATION DETAILS
========================================================= */

.registration-details {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 22px;
}

.details-heading {
    display: flex;
    align-items: center;
    gap: 9px;

    background: #f5f8fb;

    padding: 13px 17px;

    color: #174a78;

    font-size: 14px;
    font-weight: 700;

    border-bottom: 1px solid #e2e8f0;
}

.details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
}

.detail-item {
    display: flex;
    flex-direction: column;
    gap: 5px;

    padding: 14px 17px;

    border-bottom: 1px solid #edf1f5;
}

.detail-item:nth-child(odd) {
    border-right: 1px solid #edf1f5;
}

.detail-label {
    font-size: 11px;
    color: #667085;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

.detail-value {
    font-size: 14px;
    color: #243447;
    font-weight: 600;
    word-break: break-word;
}

.registration-number {
    color: #174a78;
    font-weight: 700;
}


/* =========================================================
   NEXT STEP
========================================================= */

.next-step-box {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px;

    margin-bottom: 20px;
}

.next-step-title {
    display: flex;
    align-items: center;
    gap: 9px;

    color: #174a78;

    font-size: 14px;
    font-weight: 700;

    margin-bottom: 18px;
}

.registration-steps {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.registration-step {
    display: flex;
    flex-direction: column;
    align-items: center;

    text-align: center;

    width: 24%;
}

.step-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    font-size: 14px;

    margin-bottom: 8px;
}

.registration-step.completed .step-icon {
    background: #198754;
    color: #ffffff;
}

.registration-step.active .step-icon {
    background: #174a78;
    color: #ffffff;
}

.registration-step.pending .step-icon {
    background: #eef2f6;
    color: #667085;
}

.step-content strong {
    display: block;

    font-size: 11px;
    color: #344054;

    line-height: 1.4;
}

.step-content span {
    display: block;

    margin-top: 3px;

    font-size: 10px;
    color: #667085;

    line-height: 1.4;
}

.step-line {
    height: 2px;
    flex: 1;

    background: #dfe5eb;

    margin: 18px 5px 0;
}


/* =========================================================
   IMPORTANT NOTE
========================================================= */

.important-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;

    padding: 13px 15px;

    background: #fff8e6;
    border: 1px solid #f3dfaa;

    border-radius: 10px;

    color: #6b5b2a;

    font-size: 12px;
    line-height: 1.55;
}

.important-note > i {
    color: #d88a00;
    font-size: 16px;
    margin-top: 2px;
}

.important-note strong {
    color: #735d19;
}


/* =========================================================
   FOOTER
========================================================= */

.success-footer {
    background: #f8fafc;
    border-top: 1px solid #e8edf2;

    padding: 14px 24px;
}

.success-close-btn {
    min-width: 125px;

    background: #174a78;
    border-color: #174a78;

    border-radius: 7px;

    font-size: 13px;
    font-weight: 600;

    padding: 9px 18px;
}

.success-close-btn:hover {
    background: #123b60;
    border-color: #123b60;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 767px) {

    .registration-success-modal {
        margin: 10px;
    }

    .registration-success-modal .modal-body {
        padding: 18px;
    }

    .success-header {
        padding: 17px;
    }

    .success-header .modal-title {
        font-size: 17px;
    }

    .details-grid {
        grid-template-columns: 1fr;
    }

    .detail-item:nth-child(odd) {
        border-right: 0;
    }

    .registration-steps {
        flex-direction: column;
        gap: 12px;
    }

    .registration-step {
        width: 100%;

        flex-direction: row;
        align-items: center;

        text-align: left;
        gap: 10px;
    }

    .step-icon {
        margin-bottom: 0;
        flex-shrink: 0;
    }

    .step-line {
        display: none;
    }

}

</style>

<style>
/* =========================================================
  SUCCESS  MODAL DIALOG MODAL
   OFFICIAL WHITE DOCUMENT STYLE
========================================================= */
.auth-modal-dialog {
    width: 96%;
