}
.auth-subject strong {
    color: #173f67;
    white-space: nowrap;
}

/* =========================================================
   FORMAL LETTER CONTENT
   ========================================================= */
.auth-formal-letter {
    margin-bottom: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: #303840;
}
.auth-formal-letter p {
    margin-top: 0;
    margin-bottom: 7px;
}

/* =========================================================
   PROCEDURE SECTION
   ========================================================= */
.auth-procedure {
    margin-bottom: 10px;
}

/* =========================================================
   PROCEDURE GRID
   ========================================================= */
.auth-procedure-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px 10px;
}

/* =========================================================
   PROCEDURE ITEM
   ========================================================= */
.auth-procedure-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 55px;
    padding: 8px 10px;
    border: 1px solid #d5dae0;
    border-radius: 3px;
    background: #ffffff;
}

/* =========================================================
   PROCEDURE NUMBER
   ========================================================= */
.auth-number {
    flex: 0 0 31px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 31px;
    height: 31px;
    border-radius: 50%;
    background: #173f67;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
}

/* =========================================================
   PROCEDURE CONTENT
   ========================================================= */
.auth-procedure-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}
