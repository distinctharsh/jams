    letter-spacing: 0.7px;
    line-height: 1.4;
    color: #173f67;
}

/* =========================================================
   HEADER SUBTITLE
   ========================================================= */
.auth-header-subtitle {
    margin-top: 4px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.4px;
    line-height: 1.4;
    color: #4f5964;
}

/* =========================================================
   CLOSE BUTTON
   ========================================================= */
.auth-close {
    position: absolute;
    top: 14px;
    right: 17px;
    z-index: 10;
    opacity: 0.65;
    filter: none;
}
.auth-close:hover {
    opacity: 1;
}

/* =========================================================
   LETTER BODY
   ========================================================= */
.auth-letter-body {
    flex: 1;
    min-height: 0;
    padding: 18px 30px 16px;
    background: #ffffff;
    overflow: hidden;
}

/* =========================================================
   OLD REFERENCE ROW - HIDDEN
   ========================================================= */
.auth-reference-row {
    display: none !important;
}

/* =========================================================
   LETTER HEADING
   ========================================================= */
.auth-letter-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin: 14px 0 16px;
}

/* =========================================================
   HEADING LINES
   ========================================================= */
.auth-heading-line {
    flex: 1;
    max-width: 180px;
    height: 1px;
    background: #9aa1a8;
}

/* =========================================================
   HEADING CONTENT
   ========================================================= */
.auth-heading-content {
    text-align: center;
    white-space: nowrap;
}
.auth-heading-content h4 {
    margin: 0;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: 1px;
    line-height: 1.35;
    color: #173f67;
}
.auth-heading-content span {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.8px;
    line-height: 1.4;
    color: #59636e;
}

/* =========================================================
   SECTION HEADING
   ========================================================= */
.auth-section-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    color: #173f67;
}
.auth-section-heading i {
    font-size: 16px;
    color: #173f67;
}

/* =========================================================
   APPLICANT DETAILS SECTION
   ========================================================= */
.auth-formal-section {
    margin-bottom: 11px;
}

/* =========================================================
   APPLICANT DETAILS TABLE
   ========================================================= */
.auth-details-table {
    width: 100%;
    border: 1px solid #cfd5db;
    border-radius: 3px;
    overflow: hidden;
    background: #ffffff;
}

/* =========================================================
   TABLE ROW
   ========================================================= */
.auth-table-row {
    display: grid;
    grid-template-columns: 210px 1fr;
    min-height: 34px;
    border-bottom: 1px solid #dfe3e7;
}
.auth-table-row:last-child {
    border-bottom: 0;
}

/* =========================================================
   TABLE LABEL
   ========================================================= */
.auth-table-label {
    display: flex;
    align-items: center;
    padding: 7px 11px;
