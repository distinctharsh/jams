}

/* ==========================================
   CAPTCHA
========================================== */

.captcha-box {
    height: 44px;
    border: 1px dashed #9fb3c8;
    border-radius: 9px;
    background:
        linear-gradient(
            135deg,
            #f8fafc,
            #eef4f8
        );
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px 0 15px;
    overflow: hidden;
}

.captcha-text {
    font-family: "Courier New", monospace;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 4px;
    color: #1e3a5f;
    user-select: none;
    text-decoration: line-through;
