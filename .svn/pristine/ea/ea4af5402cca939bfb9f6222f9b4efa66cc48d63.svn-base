    margin: 1rem auto;
}

/* =========================================================
   MAIN MODAL
   ========================================================= */
.auth-gov-modal {
    position: relative;
    width: 100%;
    max-height: calc(100vh - 30px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #c8cdd3;
    border-radius: 4px;
    background: #ffffff;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.18);
}

/* =========================================================
   GOVERNMENT HEADER
   ========================================================= */
.auth-gov-header {
    position: relative;
    flex-shrink: 0;
    padding: 16px 55px 14px;
    border-bottom: 1px solid #cfd4d9;
    background: #ffffff;
