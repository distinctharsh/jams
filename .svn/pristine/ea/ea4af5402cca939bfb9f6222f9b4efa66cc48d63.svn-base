    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    color: #3f4852;
}

/* =========================================================
   TABLE VALUE
   ========================================================= */
.auth-table-value {
    display: flex;
    align-items: center;
    padding: 7px 11px;
    font-size: 12px;
    line-height: 1.4;
    color: #20262d;
}

/* =========================================================
   SUBJECT
   ========================================================= */
.auth-subject {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 11px;
    margin-bottom: 11px;
    border-top: 1px solid #e1e4e7;
    border-right: 1px solid #e1e4e7;
    border-bottom: 1px solid #e1e4e7;
    border-left: 3px solid #173f67;
