}

.captcha-refresh {
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 7px;
    background: #e3edf6;
    color: #1e4d7b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all .2s ease;
}

.captcha-refresh:hover {
    background: #1e4d7b;
    color: #fff;
    transform: rotate(20deg);
}

.captcha-refresh i {
    font-size: 17px;
}
/* ==========================================
   CREATE ACCOUNT BUTTON
========================================== */

.signup-submit {
    height: 46px;
