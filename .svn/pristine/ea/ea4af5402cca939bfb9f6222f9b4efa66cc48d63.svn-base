<?php echo view('footer/footer'); ?>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="<?= base_url('assets/js/tost.js') ?>"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
function getCSRFHash() {
    return $('input[name="csrf_token"]').val() || '';
}

function updateCSRF(hash) {
    $('input[name="csrf_token"]').val(hash);
}

function toggleSignupPassword() {
    const passwordInput = document.getElementById('signup_password');
    const eyeIcon = document.getElementById('signupEyeIcon');
    if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.className = 'bi bi-eye-slash-fill';
    } else {
        passwordInput.type = 'password';
        eyeIcon.className = 'bi bi-eye-fill';
    }
}

function refreshSignupCaptcha() {
    $.ajax({
        url: "<?= base_url('refresh-captcha') ?>",
        type: "POST",
        data: { csrf_token: getCSRFHash() },
        dataType: "json",
        headers: { "X-Requested-With": "XMLHttpRequest" },
        success: function(response) {
            if (response.csrfHash) updateCSRF(response.csrfHash);
            if (response.success) {
                $('#signupCaptchaText').text(response.captcha);
                $('#signup_captcha').val('');
            }
        }
    });
}

$(document).ready(function () {
    refreshSignupCaptcha();
    $('#signupRefreshCaptcha').on('click', function () {
        refreshSignupCaptcha();
    });
    $('#signup_body_type').on('change', function () {
        const isUgcRequired = $(this).find(':selected').data('ugc-required');

        if (parseInt(isUgcRequired) === 1) {
            $('#ugc_input_container')
                .stop(true, true)
                .slideDown(200);

            $('#signup_ugc_details')
                .prop('required', true);
        } else {
            $('#ugc_input_container')
                .stop(true, true)
                .slideUp(200);

            $('#signup_ugc_details')
                .prop('required', false)
                .val('');
        }
    });


    /*
     * =========================================================
     * BODY NAME CHANGE
     * =========================================================
     */
    $('#signup_body_name').on('change', function () {
        const selectedOrgType = $(this).find(':selected').data('org-type');

        if (selectedOrgType) {
            $('#signup_body_type option').each(function () {
                if ($(this).data('type-id') == selectedOrgType) {
                    $(this).prop('selected', true);
                    return false;
                }
            });

            $('#signup_body_type').trigger('change');
        }
    });


    /*
     * =========================================================
     * EMAIL VALIDATION
     * =========================================================
     */
    function validateEmail(email) {
        email = $.trim(email);

        if (email === '') {
            return false;
        }

        const pattern = /^[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$/;
        return pattern.test(email);
    }
    /*
     * =========================================================
     * MOBILE VALIDATION
     * EXACTLY 11 DIGITS
     * =========================================================
     */
    function validateMobile(mobile) {
        mobile = $.trim(mobile);
        return /^[0-9]{10,11}$/.test(mobile);
    }
    /*
     * =========================================================
     * EMAIL BLUR
     * =========================================================
     */
    $('#signup_email').on('blur', function () {
        const email = $.trim($(this).val());

        if (email === '') {
            return;
        }

        if (!validateEmail(email)) {
            $(this).addClass('is-invalid');
            $(this).siblings('.invalid-feedback').remove();
            $(this).after(
                '<div class="invalid-feedback">' +
                'Please enter a valid email address.' +
                '</div>'
            );
        } else {
            $(this).removeClass('is-invalid');
            $(this).siblings('.invalid-feedback').remove();
        }
    });


    /*
     * =========================================================
     * MOBILE INPUT
     * ONLY NUMBER | MAX 11 DIGITS
     * =========================================================
     */
    $('#signup_mobile').on('input', function () {
        let value = $(this).val();

        // Remove non-numeric characters
        value = value.replace(/\D/g, '');

        // Maximum 11 digits
        if (value.length > 11) {
            value = value.substring(0, 11);
        }

        $(this).val(value);
    });


    /*
     * =========================================================
     * MOBILE BLUR
     * =========================================================
     */
    $('#signup_mobile').on('blur', function () {
        const mobile = $.trim($(this).val());
        if (mobile === '') {
            return;
        }
        if (!validateMobile(mobile)) {
            $(this).addClass('is-invalid');
            $(this).siblings('.invalid-feedback').remove();

            $(this).after(
                '<div class="invalid-feedback">' +
                'Mobile Number must contain exactly 10 or 11 digits.' +
                '</div>'
            );
        } else {
            $(this).removeClass('is-invalid');
            $(this).siblings('.invalid-feedback').remove();
        }
    });


   
/* 
 * =========================================================
 * SIGNUP FORM SUBMIT
 * =========================================================
*/
$('#signupForm').on('submit', function (e) {
    e.preventDefault();
    const fullName = $.trim($('#signup_full_name').val() || '');
    const email    = $.trim($('#signup_email').val() || '');
    const mobile   = $.trim($('#signup_mobile').val() || '');
    const selectedBodyOption = $('#signup_body_name option:selected');
    const bodyName = selectedBodyOption.attr('data-org-type') || '';
    const selectedTypeOption = $('#signup_body_type option:selected');
    const bodyType = selectedTypeOption.attr('data-type-id') || '';
    const ugcRequired = selectedTypeOption.attr('data-ugc-required') || '';
    const ugcDetails = $.trim($('#signup_ugc_details').val() || '');
    const captcha = $.trim($('#signup_captcha').val() || '');
    const csrfToken = $('input[name="csrf_token"]').val() || '';
    // -----------------------------------------------------
    // CLIENT VALIDATION
    // -----------------------------------------------------
    if (fullName.length < 3) {
        showToast(
            'error',
            'Please enter a valid Full Name.'
        );
        $('#signup_full_name').focus();
        return;
    }
    if (!validateEmail(email)) {
        showToast(
            'error',
            'Please enter a valid email address.'
        );
        $('#signup_email').focus();
        return;
    }
    if (!validateMobile(mobile)) {
        showToast(
            'error',
            'Mobile Number must contain 10 or 11 digits.'
        );
        $('#signup_mobile').focus();
        return;
    }
    if (!bodyName) {
        showToast(
            'error',
            'Please select Body Name.'
        );
        $('#signup_body_name').focus();
        return;
    }
    if (!bodyType) {
        showToast(
            'error',
            'Please select Body Type.'
        );
        $('#signup_body_type').focus();
        return;
    }
    if (!captcha) {
        showToast(
            'error',
            'Please enter CAPTCHA code.'
        );
        $('#signup_captcha').focus();
        return;
    }
    const formData = {

        full_name   : fullName,
        email       : email,
        mobile      : mobile,
        body_name   : bodyName,
        body_type   : bodyType,
        ugc_details : ugcDetails,
        captcha     : captcha,
        csrf_token  : csrfToken

    };
    console.log(
        'Signup Form Data:',
        formData
    );
    $.ajax({
        url      : "<?= base_url('auth/register') ?>",
        type     : "POST",
        data     : formData,
        dataType : "json",
        beforeSend : function () {

            $('#signupBtn')
                .prop('disabled', true)
                .html(
                    '<i class="bi bi-hourglass-split me-2"></i>Registering...'
                );

        },
        success : function (response) {
            console.log(
                'Register Response:',
                response
            );
            if (response.csrfHash) {

                $('input[name="csrf_token"]')
                    .val(response.csrfHash);

            }
            if (response.success) {
                const registrationNo =
                    response.reg_no || '';
                const authLink =
                    response.auth_link ||
                    response.redirect ||
                    '';
                console.log(
                    'Registration Number:',
                    registrationNo
                );

                console.log(
                    'Authorization Link:',
                    authLink
                );
                if ($('#registrationNumber').length) {

                    $('#registrationNumber')
                        .text(registrationNo);

                }
                if (
                    typeof showEmailPopup === 'function'
                ) {
                    showEmailPopup(
                        registrationNo,
                        fullName,
                        email,
                        mobile,
                        authLink
                    );
                } else {
                    // Fallback
                    if (authLink) {

                        window.location.href =
                            authLink;
                    }
                }
                return;
            }
            if (response.errors) {
                let errors = '';
                $.each(
                    response.errors,
                    function (field, message) {

                        errors +=
                            message +
                            '<br>';

                    }
                );
                showToast(
                    'error',
                    errors
                );
            } else {
                showToast(
                    'error',
                    response.message ||
                    'Registration failed.'
                );
            }
            enableSignupButton();
        },
        error : function (xhr) {
            console.error(
                'Registration Error:',
                xhr.responseText
            );
            let message =
                'Server error. Please try again.';
            if (xhr.responseJSON) {
                if (xhr.responseJSON.message) {
                    message =
                        xhr.responseJSON.message;
                }
                if (xhr.responseJSON.errors) {
                    let errors = '';
                    $.each(
                        xhr.responseJSON.errors,
                        function (field, errorMessage) {
                            errors +=
                                errorMessage +
                                '<br>';

                        }
                    );
                    if (errors) {

                        message = errors;

                    }
                }

            }
            showToast(
                'error',
                message
            );
            enableSignupButton();
        },
        complete : function () {
            if (
                typeof refreshSignupCaptcha ===
                'function'
            ) {
                refreshSignupCaptcha();

            }
        }
    });
});

/* 
 * =========================================================
 * ENABLE SIGNUP BUTTON
 * =========================================================
 */
function enableSignupButton() {
    $('#signupBtn')
        .prop('disabled', false)
        .html(
            '<i class="bi bi-person-plus-fill me-2"></i>Create Account'
        );
}

/* 
 * =========================================================
 * EMAIL VERIFICATION / REGISTRATION SUCCESS POPUP
 * =========================================================
 */
window.showEmailPopup = function (
    registrationNo,
    fullName,
    email,
    mobile,
    authLink
) {
    const popupElement = document.getElementById('emailPopup');

    if (!popupElement) {
        console.warn('emailPopup element not found.');

        if (typeof showAuthLinkPopup === 'function') {
            showAuthLinkPopup(
                registrationNo,
                fullName,
                email,
                mobile,
                authLink
            );
        } else if (authLink) {
            window.location.href = authLink;
        }

        return;
    }

    $('#registrationNumber').text(
        registrationNo || '-'
    );

    $('#registrationFullName').text(
        fullName || '-'
    );

    $('#registrationEmail').text(
        email || '-'
    );

    $('#registrationMobile').text(
        mobile || '-'
    );

    const emailPopup =
        bootstrap.Modal.getOrCreateInstance(
            popupElement
        );

    $(popupElement).off(
        'hidden.bs.modal.authFlow'
    );

    $(popupElement).one(
        'hidden.bs.modal.authFlow',
        function () {
            console.log(
                'Email verification popup closed.'
            );

            console.log(
                'Opening Authorization Link Popup:',
                authLink
            );

            if (typeof showAuthLinkPopup === 'function') {
                showAuthLinkPopup(
                    registrationNo,
                    fullName,
                    email,
                    mobile,
                    authLink
                );
            } else if (authLink) {
                window.location.href = authLink;
            }
        }
    );

    emailPopup.show();
};

/*
 * =========================================================
 * AUTHORIZATION LINK POPUP
 * =========================================================
 */
window.showAuthLinkPopup = function (
    registrationNo,
    fullName,
    email,
    mobile,
    authUrl
) {
    const popupElement =
        document.getElementById('authLinkPopup');
    if (!authUrl) {
        console.error(
            'Authorization URL is empty.'
        );
        showToast(
            'error',
            'Authorization link could not be generated.'
        );
        return;
    }
    if (!popupElement) {
        console.warn(
            'authLinkPopup element not found.'
        );
        window.location.href = authUrl;
        return;
    }
    $('#authFullName')
        .text(fullName || 'Applicant');

    $('#authLinkRegistrationNo')
        .text(registrationNo || '-');

    $('#authLinkEmail')
        .text(email || '-');

    $('#authLinkMobile')
        .text(mobile || '-');
    $('#authLinkUrl')
        .attr('href', authUrl);
    const authLinkPopup =
        bootstrap.Modal.getOrCreateInstance(
            popupElement
        );

    authLinkPopup.show();
};

/*
 * =========================================================
 * AUTHORIZATION LINK CLICK
 * =========================================================
 */
$(document).on('click', '#authLinkUrl', function (e) {
    const authUrl = $(this).attr('href');

    if (!authUrl || authUrl === '#') {
        e.preventDefault();

        showToast(
            'error',
            'Authorization link is not available.'
        );

        return false;
    }

    console.log(
        'Opening Authorization URL:',
        authUrl
    );
    });
});


document.addEventListener('DOMContentLoaded', function () {
    const dateElement =
        document.getElementById('authLetterDate');
    if (dateElement) {
        const today = new Date();
        const options = {
            day: '2-digit',
            month: 'long',
            year: 'numeric'
        };
        dateElement.textContent =
            today.toLocaleDateString('en-IN', options);
    }
});

const registrationElement =
    document.getElementById('authLinkRegistrationNo');
const registrationHeaderElement =
    document.getElementById('authLinkRegistrationNoHeader');
if (registrationElement) {
    registrationElement.textContent = registrationNo || '-';
}
if (registrationHeaderElement) {
    registrationHeaderElement.textContent = registrationNo || '-';
}
</script>
