/* =========================================================
   MEDIA QUERIES
   ========================================================= */

/* Large screens with enough height */
@media (min-width: 769px) and (min-height: 850px) {
    .auth-letter-body {
        overflow-y: auto;
        scrollbar-width: thin;
    }
}

/* Medium height screens */
@media (max-height: 850px) and (min-width: 769px) {
    .auth-modal-dialog {
        margin: 0.35rem auto;
        min-height: calc(100vh - 0.7rem);
    }
    .auth-gov-modal {
        max-height: calc(100vh - 0.7rem);
    }
    .auth-gov-header {
        padding: 8px 50px 7px;
    }
    .auth-emblem-wrapper {
        margin-bottom: 2px;
    }
    .auth-emblem-wrapper .title-logo {
        width: 40px;
        height: 40px;
    }
    .auth-header-main {
        font-size: 16px;
    }
    .auth-header-subtitle {
        font-size: 9px;
    }
    .auth-letter-body {
        padding: 10px 25px 10px;
    }
    .auth-letter-heading {
        margin: 6px 0 9px;
    }
    .auth-heading-content h4 {
        font-size: 19px;
    }
    .auth-heading-content span {
        font-size: 10px;
    }
    .auth-section-heading {
        font-size: 13px;
        margin-bottom: 5px;
    }
    .auth-formal-section {
        margin-bottom: 7px;
    }
    .auth-table-row {
        min-height: 29px;
    }
    .auth-table-label,
    .auth-table-value {
        padding: 5px 9px;
        font-size: 12px;
    }
    .auth-subject {
        padding: 6px 9px;
        margin-bottom: 7px;
        font-size: 12px;
    }
    .auth-formal-letter {
        margin-bottom: 7px;
        font-size: 12px;
        line-height: 1.35;
    }
    .auth-formal-letter p {
        margin-bottom: 4px;
    }
    .auth-procedure {
        margin-bottom: 7px;
    }
    .auth-procedure-grid {
        gap: 5px 8px;
    }
    .auth-procedure-item {
        min-height: 42px;
        padding: 5px 8px;
    }
    .auth-number {
        width: 28px;
        height: 28px;
        flex-basis: 28px;
    }
    .auth-procedure-content strong {
        font-size: 12px;
    }
    .auth-procedure-content span {
        font-size: 9.5px;
    }
    .auth-official-notice {
        padding: 6px 9px;
        margin-bottom: 6px;
    }
    .auth-notice-icon {
        width: 24px;
        height: 24px;
        flex-basis: 24px;
    }
    .auth-notice-title {
        font-size: 10px;
    }
    .auth-notice-content li {
        font-size: 9.5px;
        line-height: 1.25;
    }
    .auth-action-section {
        padding: 6px 9px;
        margin-bottom: 5px;
    }
    .auth-action-title {
        font-size: 12px;
    }
    .auth-action-description {
        font-size: 9.5px;
    }
    .auth-proceed-btn {
        min-width: 185px;
        padding: 8px 13px;
        font-size: 10px;
    }
    .auth-declaration {
        padding-top: 4px;
        font-size: 8.5px;
    }
    .auth-gov-footer {
        padding: 6px 18px;
        font-size: 9px;
    }
    .auth-close-btn {
        padding: 4px 12px;
        font-size: 9px;
    }
}

/* Tablets & smaller screens (max-width: 900px) */
@media (max-width: 900px) {
    .auth-modal-dialog {
        width: 98%;
    }
    .auth-letter-body {
        padding-left: 18px;
        padding-right: 18px;
    }
    .auth-table-row {
        grid-template-columns: 180px 1fr;
    }
}

/* Mobile (max-width: 768px) */
@media (max-width: 768px) {
    .auth-modal-dialog {
        width: 98%;
        margin: 0.35rem auto;
        min-height: calc(100vh - 0.7rem);
    }
    .auth-gov-modal {
        max-height: calc(100vh - 0.7rem);
    }
    .auth-gov-header {
        padding: 10px 42px 9px;
    }
    .auth-emblem-wrapper .title-logo {
        width: 44px;
        height: 44px;
    }
    .auth-header-main {
        font-size: 15px;
    }
    .auth-header-subtitle {
        font-size: 9px;
    }
    .auth-letter-body {
        padding: 12px;
        overflow-y: auto;
    }
    .auth-letter-heading {
        gap: 8px;
        margin: 8px 0 12px;
    }
    .auth-heading-line {
        max-width: 60px;
    }
    .auth-heading-content h4 {
        font-size: 17px;
    }
    .auth-heading-content span {
        font-size: 9px;
    }
    .auth-table-row {
        grid-template-columns: 140px 1fr;
    }
    .auth-table-label,
    .auth-table-value {
        font-size: 11px;
        padding: 6px 8px;
    }
    .auth-subject {
        font-size: 11px;
    }
    .auth-formal-letter {
        font-size: 11px;
        line-height: 1.45;
    }
    .auth-procedure-grid {
        grid-template-columns: 1fr;
    }
    .auth-final-step {
        grid-column: auto;
    }
    .auth-procedure-content strong {
        font-size: 11px;
    }
    .auth-procedure-content span {
        font-size: 9px;
    }
    .auth-action-section {
        flex-direction: column;
        align-items: stretch;
    }
    .auth-proceed-btn {
        width: 100%;
        min-width: 0;
    }
    .auth-gov-footer {
        flex-direction: column;
        gap: 6px;
        text-align: center;
    }
    .auth-footer-left,
    .auth-footer-right {
        justify-content: center;
        flex-wrap: wrap;
    }
}

/* Small phones (max-width: 480px) */
@media (max-width: 480px) {
    .auth-header-main {
        font-size: 13px;
    }
    .auth-heading-content h4 {
        font-size: 15px;
    }
    .auth-heading-content span {
        font-size: 8px;
    }
    .auth-table-row {
        grid-template-columns: 115px 1fr;
    }
    .auth-table-label,
    .auth-table-value {
        font-size: 10px;
    }
    .auth-formal-letter {
        font-size: 10.5px;
    }
    .auth-subject {
        font-size: 10px;
    }
}
