}

/* =========================================================
   FAQ SECTION
   ========================================================= */

#faqs {
    position: relative;
    padding: 60px 0 70px;
    background:
        radial-gradient(
            circle at 5% 15%,
            rgba(30,77,123,.045),
            transparent 25%
        ),
        radial-gradient(
            circle at 95% 85%,
            rgba(255,153,51,.045),
            transparent 25%
        ),
        linear-gradient(
            180deg,
            #f7fafd 0%,
            #ffffff 100%
        );
    overflow: hidden;
}

#faqs::after {
    content: "";
    position: absolute;
    width: 260px;
    height: 260px;
    left: -170px;
    bottom: -150px;
    border-radius: 50%;
    border: 45px solid rgba(30,77,123,.035);
    pointer-events: none;
}

.faq-header {
    position: relative;
    z-index: 2;
    max-width: 850px;
    margin: 0 auto 30px;
    text-align: center;
}

.faq-header h2 {
    position: relative;
    display: inline-block;
    margin: 0 0 12px;
    color: #1e4d7b;
    font-size: 31px;
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -.4px;
}

.faq-header h2::after {
    content: "";
    display: block;
    width: 65px;
    height: 4px;
    margin: 10px auto 0;
    border-radius: 10px;
    background: #1e4d7b;
}

.faq-header p {
    max-width: 720px;
    margin: 0 auto;
    color: #667085;
    font-size: 13px;
    line-height: 1.65;
    font-weight: 400;
}

.faq-wrapper {
    position: relative;
    z-index: 2;
    max-width: 1150px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 14px;
}

.faq-item {
    position: relative;
    margin: 0;
    background: #fff;
    border: 1px solid #dfe6ed;
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
        0 5px 16px rgba(30,77,123,.055);
    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

.faq-item:hover {
    border-color: rgba(30,77,123,.22);
    transform: translateY(-2px);
    box-shadow:
        0 10px 25px rgba(30,77,123,.09);
}

.faq-item:nth-child(7) {
    grid-column: 1 / -1;
}

.faq-question {
    width: 100%;
    min-height: 66px;
    padding: 13px 18px;
    border: 0;
    outline: none;
    background: #fff;
    color: #173f6b;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    text-align: left;
    cursor: pointer;
    font-size: 15px;
    line-height: 1.45;
    font-weight: 700;
    transition:
        background .25s ease,
        color .25s ease;
}

.faq-question:hover {
    background: #f8fafc;
}

.faq-question[aria-expanded="true"] {
    background: #f3f7fb;
    color: #163a5b;
}

.faq-question-text {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    line-height: 1.45;
    flex: 1;
}

.faq-number {
    min-width: 34px;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #1e4d7b;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    box-shadow:
        0 4px 10px rgba(30,77,123,.16);
    transition:
        background .25s ease,
        transform .25s ease,
        box-shadow .25s ease;
}

.faq-question[aria-expanded="true"] .faq-number {
    background: #FF9933;
    transform: scale(1.04);
    box-shadow:
        0 4px 10px rgba(255,153,51,.20);
}

.faq-icon {
    flex-shrink: 0;
    color: #1e4d7b;
    font-size: 17px;
    transition:
        transform .3s ease,
        color .25s ease;
}

.faq-question[aria-expanded="true"] .faq-icon {
    color: #FF9933;
    transform: rotate(180deg);
}

.faq-answer {
    padding: 0 20px 20px 65px;
    color: #56616f;
    font-size: 13.5px;
    line-height: 1.75;
    text-align: left;
    background: #fff;
}

.faq-answer p {
    margin: 0 0 9px;
}

.faq-answer ul {
    margin: 8px 0 0;
    padding-left: 20px;
}

.faq-answer ul li {
    margin-bottom: 6px;
    padding-left: 2px;
}

.faq-answer ul li:last-child {
    margin-bottom: 0;
}

.faq-answer ul li::marker {
    color: #FF9933;
    font-size: 10px;
}

.faq-answer strong {
    color: #1e4d7b;
    font-weight: 700;
}

.faq-answer a {
    color: #1e4d7b;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color .2s ease;
}

.faq-answer a:hover {
    color: #FF9933;
}

.jammer-guidelines-link {
    color: #1e4d7b;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(30, 77, 123, 0.35);
    transition: all 0.25s ease;
}

.jammer-guidelines-link:hover {
    color: #0d6efd;
    border-bottom-color: #0d6efd;
}

