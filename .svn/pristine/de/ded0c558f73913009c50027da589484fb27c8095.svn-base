/* =========================================================
   MAIN WRITE-UP CARD
   ========================================================= */

.main-writeup {
    position: relative;
    margin-top: 0;
    padding: 24px 24px 22px;
    background: rgba(255,255,255,.98);
    border: 1px solid #e1e7ee;
    border-radius: 15px;
    box-shadow:
        0 12px 32px rgba(30,77,123,.075),
        0 3px 10px rgba(0,0,0,.025);
    overflow: hidden;
    transition:
        box-shadow .3s ease,
        transform .3s ease;
}

.main-writeup::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: #1e4d7b;
    border-radius: 15px 15px 0 0;
}

.main-writeup-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.main-writeup-list li {
    position: relative;
    padding: 0 0 14px 42px;
    margin: 0 0 14px;
    color: #303b48;
    font-size: 14px;
    line-height: 1.72;
    text-align: left;
    border-bottom: 1px solid #edf1f5;
}

.main-writeup-list li:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: 0;
}

.main-writeup-list li::before {
    content: "\f138";
    position: absolute;
    left: 0;
    top: 1px;
    width: 27px;
    height: 27px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "bootstrap-icons";
    color: #fff;
    background: #1e4d7b;
    border-radius: 50%;
    font-size: 13px;
    box-shadow:
        0 4px 10px rgba(30,77,123,.16);
    transition:
        background .25s ease,
        transform .25s ease;
}

.main-writeup-list li:hover::before {
    background: #FF9933;
    transform: translateX(2px);
}

.main-writeup-list a {
    color: #064fa3;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color .2s ease;
}

.main-writeup-list a:hover {
    color: #FF9933;
}

