$routes->post('dashboard/save-org-type', 'Dashboard::saveOrgType');
$routes->get('dashboard/get-org-type/(:num)', 'Dashboard::getOrgType/$1');
$routes->post('dashboard/delete-org-type/(:num)', 'Dashboard::deleteOrgType/$1');

// Vendor Routes
