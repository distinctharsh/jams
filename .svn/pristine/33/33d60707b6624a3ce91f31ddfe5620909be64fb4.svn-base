// Designation Routes
$routes->get('dashboard/designations', 'Dashboard::designations');
$routes->get('dashboard/get-designations', 'Dashboard::getDesignations');
$routes->get('dashboard/get-designation/(:num)', 'Dashboard::getDesignation/$1');
